{
  "name": "practicum-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "preview:local": "node scripts/local-preview.js",
    "test:electron": "electron scripts/check-electron.cjs",
    "format": "prettier --write src backend desktop scripts tests",
    "format:check": "prettier --check src backend desktop scripts tests"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "prettier": "3.9.10",
    "vite": "8.3.0"
  }
}
